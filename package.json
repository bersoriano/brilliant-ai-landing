{
  "name": "brilliant-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-preparation.mjs && NODE_ENV=production node --conditions=react-server .cloudflare/prepare.mjs && next build && node scripts/package-pages.mjs",
    "start": "wrangler pages dev out --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "verify:seo": "node scripts/verify-seo.cjs",
    "pages:dev": "wrangler pages dev out --port 3100",
    "pages:migrate:local": "wrangler d1 migrations apply INQUIRY_RATE_LIMIT --local",
    "test:browser": "playwright test",
    "test:runtime": "node scripts/test-runtime.mjs",
    "test:pages": "node scripts/test-pages.mjs"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "next": "^15.5.28",
    "posthog-js": "^1.438.12",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261023.3-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22.0.0 <23 || >=24.0.0 <25 || >=26.0.0 <27"
  }
}
