# Public business contact address. Confirm this mailbox before launch.
NEXT_PUBLIC_CONTACT_EMAIL=hello@brilliant.dev
# Production website origin, used for social preview image URLs.
# On production, this defaults to https://brilliant.dev when unset.
NEXT_PUBLIC_SITE_URL=https://brilliant.dev

# --- PostHog analytics (optional) ---
# Public project token from PostHog Settings > Project; never a personal API key.
# With no token, analytics stays disabled. Public values are embedded at build time.
NEXT_PUBLIC_POSTHOG_KEY=
# US: https://us.i.posthog.com | EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Local development is disabled by default. Set true with a test project's token
# to verify events locally; production only needs the token and host above.
NEXT_PUBLIC_POSTHOG_DEBUG=false

# Delivery credentials are runtime secrets, not build variables.
# Configure in Cloudflare Pages Settings > Variables and Secrets for each
# environment. For local Wrangler use .dev.vars.example, NOT this file.
# Required runtime: INQUIRY_RATE_SALT (random 32+ bytes), D1 binding INQUIRY_RATE_LIMIT.
# Resend: RESEND_API_KEY + INQUIRY_FROM_EMAIL + INQUIRY_TO_EMAIL.
# Alternative: INQUIRY_WEBHOOK_URL (HTTPS).
# See docs/deployment/CLOUDFLARE.md for setup, staging and rollback.
