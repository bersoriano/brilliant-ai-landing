# Public business contact address. Confirm this mailbox before launch.
NEXT_PUBLIC_CONTACT_EMAIL=hello@brilliant.ai
# Optional HTTPS scheduling URL. When unset, CTAs lead to the email inquiry form.
NEXT_PUBLIC_BOOKING_URL=
# Production website origin, used for social preview image URLs.
# On Vercel this can be omitted; the production project URL is detected.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: trusted proxy country header (cf-ipcountry, cloudfront-viewer-country,
# or x-vercel-ip-country). Configure only if your ingress overwrites this header.
# Vercel automatically uses x-vercel-ip-country when VERCEL=1.
# GEO_COUNTRY_HEADER=cf-ipcountry

# --- Inquiry form delivery (/api/inquiry) ---
# Configure ONE transport. With neither set the endpoint returns an error and
# the form falls back to an email draft, so leads are never silently dropped.
#
# Option A — send email through Resend. All three are required together.
RESEND_API_KEY=
# Verified sending identity on your domain, e.g. "Brilliant AI <hello@yourdomain.com>"
INQUIRY_FROM_EMAIL=
# Destination mailbox. Defaults to NEXT_PUBLIC_CONTACT_EMAIL when unset.
INQUIRY_TO_EMAIL=
#
# Option B — POST each submission as JSON to an HTTPS endpoint (CRM, Zapier, Slack).
INQUIRY_WEBHOOK_URL=
